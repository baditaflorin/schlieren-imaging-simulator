{
  "name": "schlieren-imaging-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based Schlieren simulator for visualizing heat, sound, and gas density gradients with WebGPU and Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-pages-assets.mjs && tsc -b && vite build && node scripts/copy-spa-fallback.mjs",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "pages-preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "homepage": "https://baditaflorin.github.io/schlieren-imaging-simulator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/schlieren-imaging-simulator.git"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.69",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
